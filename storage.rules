rules_version = '2';

// Images des cartes : lecture pour tout utilisateur connecté,
// écriture limitée aux images < 100 Ko (le client vise 50 Ko).
// Un contrôle par appartenance au paquet nécessiterait des Cloud Functions.

service firebase.storage {
  match /b/{bucket}/o {
    match /deck-images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
